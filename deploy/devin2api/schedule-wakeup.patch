+package devin
+
+import (
+	"encoding/json"
+	"os"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/WncFht/devin2api/internal/api/anthropic/messages"
+	"github.com/WncFht/devin2api/internal/llm"
+)
+
+// TestClaudeCodeScheduleWakeupWire preserves the real client's complete tool
+// set and both scheduling/stopping arguments without inventing root anyOf.
+func TestClaudeCodeScheduleWakeupWire(t *testing.T) {
+	fixture, err := os.ReadFile("testdata/cc_tools.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var body map[string]json.RawMessage
+	if err := json.Unmarshal(fixture, &body); err != nil {
+		t.Fatal(err)
+	}
+	body["model"] = json.RawMessage(`"claude-opus-5-5-xhigh"`)
+	body["messages"] = json.RawMessage(`[{"role":"user","content":"hello"}]`)
+	encoded, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := messages.DecodeRequest(encoded, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	request, _, err := buildRequest(decoded.Context, Config{}, callBinding{Model: "claude-opus-5-5-xhigh"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(request.GetTools()) != len(decoded.Context.Tools) {
+		t.Fatalf("lost tools: %d -> %d", len(decoded.Context.Tools), len(request.GetTools()))
+	}
+	for _, tool := range request.GetTools() {
+		if tool.GetName() != "ScheduleWakeup" {
+			continue
+		}
+		var actual map[string]any
+		if err := json.Unmarshal([]byte(tool.GetJsonSchemaString()), &actual); err != nil {
+			t.Fatal(err)
+		}
+		var expected map[string]any
+		if err := json.Unmarshal([]byte(`{"type":"object","properties":{"delaySeconds":{"type":"number"},"reason":{"type":"string"},"prompt":{"type":"string"},"stop":{"type":"boolean"},"noop":{"type":"boolean"}},"additionalProperties":false}`), &expected); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(actual, expected) {
+			t.Fatalf("ScheduleWakeup contract changed: %s", tool.GetJsonSchemaString())
+		}
+		for _, text := range []string{"ScheduleWakeup", "delaySeconds", "prompt", "noop", "Required unless `stop` is true"} {
+			if !strings.Contains(request.GetPrompt(), text) {
+				t.Fatalf("tool instructions lost %q", text)
+			}
+		}
+		return
+	}
+	t.Fatal("ScheduleWakeup missing from complete Claude Code tool set")
+}
+
+// TestToolProseDoesNotRewriteConstraints covers the cache path and confirms
+// that descriptions cannot demote explicit required fields or add constraints.
+func TestToolProseDoesNotRewriteConstraints(t *testing.T) {
+	for _, composition := range []string{"", `,"anyOf":[{"required":["stop"]},{"required":["prompt"]}]`, `,"oneOf":[{"required":["stop"]},{"required":["prompt"]}]`} {
+		schema := `{"type":"object","properties":{"prompt":{"type":"string","description":"Required unless ` + "`stop`" + ` is true."},"stop":{"type":"boolean"}},"required":["prompt"],"additionalProperties":false` + composition + `}`
+		tool := llm.ToolDefinition{Name: "conditional_tool", InputSchema: json.RawMessage(schema)}
+		original := string(tool.InputSchema)
+		for range 2 {
+			converted, err := convertToolDefinition(tool, &llm.RequestRepairs{})
+			if err != nil {
+				t.Fatal(err)
+			}
+			var actual map[string]any
+			if err := json.Unmarshal([]byte(converted.GetJsonSchemaString()), &actual); err != nil {
+				t.Fatal(err)
+			}
+			var expected map[string]any
+			if err := json.Unmarshal([]byte(strings.ReplaceAll(schema, `,"description":"Required unless `+"`stop`"+` is true."`, "")), &expected); err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(actual, expected) || string(tool.InputSchema) != original {
+				t.Fatalf("explicit schema constraints changed: %s", converted.GetJsonSchemaString())
+			}
+		}
+	}
+}
