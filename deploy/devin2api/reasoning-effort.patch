+package devin
+
+import (
+	"fmt"
+	"regexp"
+	"slices"
+	"strings"
+
+	"github.com/WncFht/devin2api/internal/llm"
+)
+
+// The effort component belongs to the upstream UID. Preserve service variants
+// (such as -fast, -priority and -lightning) when switching effort.
+var effortModelPattern = regexp.MustCompile(`^(.*)-(none|minimal|low|medium|high|xhigh|max|ultra)(-[a-z0-9-]+)?$`)
+
+// resolveReasoningEffort selects an exact same-family variant from the loaded
+// catalog. Explicit effort overrides a suffix supplied by the client or an alias.
+// It never guesses unsupported variants or silently downgrades the requested effort.
+func (adapter *Adapter) resolveReasoningEffort(model, effort string) (string, error) {
+	if effort == "" {
+		return model, nil
+	}
+	adapter.modelsMu.RLock()
+	defer adapter.modelsMu.RUnlock()
+	if len(adapter.models) == 0 {
+		return "", &llm.Failure{Code: "unavailable", Message: "model catalog unavailable; cannot resolve reasoning effort"}
+	}
+	family := model
+	if parts := effortModelPattern.FindStringSubmatch(model); parts != nil {
+		family = parts[1] + parts[3]
+		// A family name can itself end in an effort word (nemotron-3-ultra).
+		// Prefer an exact catalog family over interpreting that word as a suffix.
+		for _, candidate := range adapter.models {
+			candidateParts := effortModelPattern.FindStringSubmatch(candidate.ID)
+			if candidateParts != nil && candidateParts[1]+candidateParts[3] == model {
+				family = model
+				break
+			}
+		}
+	}
+	var supported []string
+	for _, candidate := range adapter.models {
+		parts := effortModelPattern.FindStringSubmatch(candidate.ID)
+		if parts == nil || parts[1]+parts[3] != family {
+			continue
+		}
+		if parts[2] == effort {
+			return candidate.ID, nil
+		}
+		supported = append(supported, parts[2])
+	}
+	slices.Sort(supported)
+	return "", &llm.Failure{Code: "invalid_argument", Message: fmt.Sprintf(
+		"model %q does not support reasoning effort %q; supported efforts: [%s]", model, effort, strings.Join(supported, ", "))}
+}
