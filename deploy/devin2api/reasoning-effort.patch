+
+// TestResolveReasoningEffort covers aliases, explicit suffixes and service tiers
+// without accepting a fabricated model or crossing model families.
+func TestResolveReasoningEffort(t *testing.T) {
+	a := &Adapter{models: []adapter.ModelInfo{
+		{ID: "claude-opus-5-5-low"}, {ID: "claude-opus-5-5-medium"},
+		{ID: "claude-opus-5-5-high"}, {ID: "claude-opus-5-5-max"},
+		{ID: "claude-opus-5-5-low-fast"}, {ID: "claude-opus-5-5-high-fast"},
+		{ID: "gpt-6-sol-none-priority"}, {ID: "gpt-6-sol-high-priority"},
+		{ID: "swe-2-high-lightning"}, {ID: "swe-2-max-lightning"},
+		{ID: "gemini-4-argon-low"}, {ID: "gemini-4-argon-high"},
+		{ID: "nemotron-3-ultra-low"}, {ID: "nemotron-3-ultra-high"},
+	}}
+	for _, tc := range []struct{ model, effort, want, errorCode string }{
+		{"claude-opus-5-5", "high", "claude-opus-5-5-high", ""},
+		{"claude-opus-5-5-medium", "max", "claude-opus-5-5-max", ""},
+		{"claude-opus-5-5-high", "low", "claude-opus-5-5-low", ""},
+		{"claude-opus-5-5-high", "", "claude-opus-5-5-high", ""},
+		{"claude-opus-5-5-fast", "high", "claude-opus-5-5-high-fast", ""},
+		{"claude-opus-5-5-low-fast", "high", "claude-opus-5-5-high-fast", ""},
+		{"gpt-6-sol-high-priority", "none", "gpt-6-sol-none-priority", ""},
+		{"swe-2-high-lightning", "max", "swe-2-max-lightning", ""},
+		{"nemotron-3-ultra", "high", "nemotron-3-ultra-high", ""},
+		{"nemotron-3-ultra-high", "low", "nemotron-3-ultra-low", ""},
+		{"claude-opus-5-5", "none", "", "invalid_argument"},
+		{"claude-opus-5-5-low-fast", "max", "", "invalid_argument"},
+		{"gemini-4-argon-low", "max", "", "invalid_argument"},
+		{"missing-model", "high", "", "invalid_argument"},
+		{"claude-opus-5-5", "typo", "", "invalid_argument"},
+	} {
+		t.Run(tc.model+"/"+tc.effort, func(t *testing.T) {
+			got, err := a.resolveReasoningEffort(tc.model, tc.effort)
+			if tc.errorCode != "" {
+				if err == nil || llm.Classify(err).Code != tc.errorCode || !strings.Contains(err.Error(), "supported efforts:") {
+					t.Fatalf("got %q, %v; want %s with supported efforts", got, err, tc.errorCode)
+				}
+				return
+			}
+			if err != nil || got != tc.want {
+				t.Fatalf("got %q, %v; want %q", got, err, tc.want)
+			}
+		})
+	}
+	if _, err := (&Adapter{}).resolveReasoningEffort("model", "high"); err == nil || llm.Classify(err).Code != "unavailable" {
+		t.Fatalf("empty catalog error = %v", err)
+	}
+	if got, err := (&Adapter{}).resolveReasoningEffort("unchanged", ""); err != nil || got != "unchanged" {
+		t.Fatalf("request without effort changed: %q, %v", got, err)
+	}
+}
+
+// TestClientReasoningEffort checks all three public JSON contracts and confirms
+// that non-string values fail decoding instead of silently selecting a default.
+func TestClientReasoningEffort(t *testing.T) {
+	for _, tc := range []struct {
+		name, body, field string
+		decode            func([]byte) (llm.RequestMessages, error)
+	}{
+		{"messages", `{"model":"claude-opus-5-5-medium","messages":[{"role":"user","content":"hi"}],"output_config":{"effort":VALUE}}`, "output_config", func(body []byte) (llm.RequestMessages, error) {
+			decoded, err := messages.DecodeRequest(body, true)
+			return decoded.Context, err
+		}},
+		{"responses", `{"model":"gpt-6-sol-medium","input":"hi","reasoning":{"effort":VALUE}}`, "reasoning", func(body []byte) (llm.RequestMessages, error) {
+			decoded, err := responses.DecodeRequest(body, true)
+			return decoded.Context, err
+		}},
+		{"chat", `{"model":"gpt-6-sol-medium","messages":[{"role":"user","content":"hi"}],"reasoning_effort":VALUE}`, "reasoning_effort", func(body []byte) (llm.RequestMessages, error) {
+			decoded, err := chat.DecodeRequest(body, true)
+			return decoded.Context, err
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			for _, value := range []string{`"high"`, `null`, `42`} {
+				decoded, err := tc.decode([]byte(strings.Replace(tc.body, "VALUE", value, 1)))
+				if value == "42" {
+					if err == nil {
+						t.Fatal("non-string effort accepted")
+					}
+					continue
+				}
+				want := "high"
+				if value == "null" {
+					want = ""
+				}
+				if err != nil || decoded.ReasoningEffort != want {
+					t.Fatalf("effort = %q, %v; want %q", decoded.ReasoningEffort, err, want)
+				}
+				for _, dropped := range decoded.Dropped {
+					if dropped == "field:"+tc.field {
+						t.Fatalf("consumed effort reported as dropped: %v", decoded.Dropped)
+					}
+				}
+			}
+		})
+	}
+}
+
+// TestEffortCacheIsolation prevents replaying a completion from another effort.
+func TestEffortCacheIsolation(t *testing.T) {
+	request := llm.RequestMessages{Model: "claude-opus-5-5-medium"}
+	if detachedRequestKey(request, "claude-opus-5-5-low") == detachedRequestKey(request, "claude-opus-5-5-high") {
+		t.Fatal("different resolved effort models shared a completion cache key")
+	}
+}
+
+// TestReasoningEffortWire verifies the real Stream path after alias resolution,
+// including rejection before the chat RPC when the requested variant is absent.
+func TestReasoningEffortWire(t *testing.T) {
+	stub := &stubUpstream{
+		catalog: []*devinproto.ExaCodeiumCommonPb_ClientModelConfig{
+			stubModelEntry("claude-opus-5-5-medium", false),
+			stubModelEntry("claude-opus-5-5-high", false),
+		},
+		chat: func(_ int, _ *devinproto.GetChatMessageRequest, stream *connect.ServerStream[devinproto.GetChatMessageResponse]) error {
+			return stubSend(stream, stubMeta(), stubDelta("OK"), stubStop())
+		},
+	}
+	server := stubServer(t, stub, nil)
+	a := stubAdapter(t, server, Config{Model: "public-model", Identity: LaneIdentity{Token: "test"}, Aliases: map[string]string{"public-model": "claude-opus-5-5-medium"}})
+	for _, effort := range []string{"high", ""} {
+		request := stubRequest()
+		request.Model = "public-model"
+		request.ReasoningEffort = effort
+		stream, err := a.Stream(context.Background(), request)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := stubDeltas(t, stubDrain(t, stream)); got != "OK" {
+			t.Fatalf("response = %q", got)
+		}
+		want := "claude-opus-5-5-medium"
+		if effort != "" {
+			want = "claude-opus-5-5-high"
+		}
+		if got := stub.requests[len(stub.requests)-1].GetChatModelUid(); got != want {
+			t.Fatalf("wire model = %q; want %q", got, want)
+		}
+	}
+	request := stubRequest()
+	request.Model = "public-model"
+	request.ReasoningEffort = "max"
+	if _, err := a.Stream(context.Background(), request); err == nil {
+		t.Fatal("unsupported effort accepted")
+	}
+	if stub.chatCalls.Load() != 2 {
+		t.Fatalf("unsupported effort reached upstream: %d chat calls", stub.chatCalls.Load())
+	}
+}
