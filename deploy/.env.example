# Manifold 部署环境变量模板
# 用法：cp .env.example .env  并填好下面几个必填项

# ─── 必填：随机密钥（用 openssl rand -hex 32 生成） ──────────
POSTGRES_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# ─── 可选：管理员账号（不设置则容器首次启动时自动生成并打日志） ───
ADMIN_EMAIL=admin@manifold.local
ADMIN_PASSWORD=

# ─── 可选：数据库基础信息（默认即可） ──────────────────────
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api

# ─── 可选：Redis 密码（生产强烈建议设置） ──────────────────
REDIS_PASSWORD=

# ─── 网络绑定 ────────────────────────────────────────────
# 默认只听 127.0.0.1，公网通过外层反向代理（Caddy/Nginx + HTTPS）转发到这里
# 临时联调可设为 0.0.0.0
BIND_HOST=127.0.0.1
SERVER_PORT=8080

# ─── 杂项 ────────────────────────────────────────────────
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_FORMAT=json
