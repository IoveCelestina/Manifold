# Manifold 部署环境变量模板
# 用法：cp .env.example .env  并填好下面几个必填项

# ─── 必填：随机密钥（用 openssl rand -hex 32 生成） ──────────
POSTGRES_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# ─── 可选：管理员账号（不设置则容器首次启动时自动生成并打日志） ───
ADMIN_EMAIL=admin@manifold.local
ADMIN_PASSWORD=

# ─── 可选：数据库基础信息（默认即可） ──────────────────────
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api

# ─── 可选：Redis 密码（生产强烈建议设置） ──────────────────
REDIS_PASSWORD=

# ─── 对外服务（Caddy 反代） ──────────────────────────────
# DOMAIN 留空：Caddy 监听 :80，纯 HTTP。两个典型场景：
#   1) 联调 / 内测：直接拿服务器 IP 访问 http://<IP>/...
#   2) CF Flexible 模式：CF 橙云 + SSL/TLS=Flexible，由 CF 边缘对用户做 HTTPS，
#      CF↔源站走明文 HTTP（CF 拿自家 *.<域名> 证书，源站不签证）
# DOMAIN 填值：Caddy 自动找 Let's Encrypt 签 HTTPS、80 跳 443
#   要求 DNS A 记录指到本机且 CF 是灰云（DNS only），LE HTTP-01 challenge 才不会被拦
DOMAIN=
# Let's Encrypt 证书快过期时往这里发提醒邮件（DOMAIN 设了才有意义）
ACME_EMAIL=Taohu0122@qq.com

# sub2api 不再 publish host port —— 仅 Caddy 通过 manifold-edge 内网访问。
# 临时本机调 admin UI 时去 docker-compose.yml 反注释 ports 那行

# ─── 备份（scripts/backup.sh，详见 docs/backup-restore.md）─
# 注意：这些变量是 scripts/backup.sh 直接从 shell 环境读，不是 docker compose 用的。
# 写在 .env 里只是集中收口；用 cron 跑备份时也可以在 cron 行里 export。
#
# GPG 公钥收件人（必填）。建议提前生成一对 4096-bit RSA 密钥：
#   gpg --batch --gen-key  (详见 docs/backup-restore.md)
# 多收件人逗号分隔：GPG_RECIPIENT=admin@example.com,offsite@example.com
GPG_RECIPIENT=
#
# 异地推送目标，留空跳过远端上传。rclone 远端语法：
#   r2:manifold-backups      (Cloudflare R2，先 rclone config 配好)
#   s3-prod:manifold/backups
#   b2:manifold-bk
RCLONE_REMOTE=

# ─── 杂项 ────────────────────────────────────────────────
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_FORMAT=json
