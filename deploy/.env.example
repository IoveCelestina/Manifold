# Manifold 部署环境变量模板
# 用法：cp .env.example .env  并填好下面几个必填项

# ─── 必填：随机密钥（用 openssl rand -hex 32 生成） ──────────
POSTGRES_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# ─── 必填：管理员凭据（init 脚本会生成不可猜的登录标识和密码） ───
# 不要提交生产值，也不要使用可猜的公开默认值。
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── 可选：数据库基础信息（默认即可） ──────────────────────
POSTGRES_USER=sub2api
POSTGRES_DB=sub2api

# ─── 可选：Redis 密码（生产强烈建议设置） ──────────────────
REDIS_PASSWORD=

# ─── 对外服务（Caddy 反代） ──────────────────────────────
# 生产应启用 Cloudflare 橙云，并先运行 scripts/origin-firewall.sh --install，
# 让 80/443 只接受 Cloudflare 官方出口网段，禁止通过源站 IP 绕过代理。
# DOMAIN 填值时 Caddy 自动申请证书；Cloudflare 应使用 Full (strict)。
DOMAIN=
# ACME 证书通知邮箱。必填生产专用地址，不要把真实地址提交进 Git。
ACME_EMAIL=

# sub2api 不再 publish host port —— 仅 Caddy 通过 manifold-edge 内网访问。
# 临时本机调 admin UI 时去 docker-compose.yml 反注释 ports 那行

# ─── 备份（scripts/backup.sh，详见 docs/backup-restore.md）─
# 注意：这些变量是 scripts/backup.sh 直接从 shell 环境读，不是 docker compose 用的。
# 写在 .env 里只是集中收口；用 cron 跑备份时也可以在 cron 行里 export。
#
# GPG 公钥收件人（必填）。建议提前生成一对 4096-bit RSA 密钥：
#   gpg --batch --gen-key  (详见 docs/backup-restore.md)
# 多收件人逗号分隔：GPG_RECIPIENT=admin@example.com,offsite@example.com
GPG_RECIPIENT=
#
# 异地推送目标，留空跳过远端上传。rclone 远端语法：
#   r2:manifold-backups      (Cloudflare R2，先 rclone config 配好)
#   s3-prod:manifold/backups
#   b2:manifold-bk
RCLONE_REMOTE=

# ─── 豆包生图（chat-demo 直连火山方舟出图 + 扣用户 sub2api 余额） ───
# chat-demo 里切到 Seedream 模型时，后端直连火山方舟出图，并按下面单价从
# “当前登录用户”的 sub2api 余额扣钱（先扣后出，出图失败自动退款）。
# 下面三个 KEY 有空缺 = 豆包生图不可用（前端只显示 gpt-image-2）。
#
# 火山方舟 API Key（控制台开通 Seedream 模型后获取）
ARK_API_KEY=
# 火山方舟 API 地址（默认即可）
ARK_BASE=https://ark.cn-beijing.volces.com/api/v3
# sub2api 管理员 API Key —— 用来按 uid 扣余额。
# 建议在 sub2api 后台单独生成一把“专用” admin key（将来可单独吊销），别复用主 key。
# ⚠ 它权限极大（能改任意用户余额），只配在服务端、只走内网调用。
SUB2API_ADMIN_KEY=
# 每张图扣多少 USD。火山按「模型 × 出图张数」计费（与分辨率无关），故按模型分档：
# ¥官价数字直接当 $（4.0 ¥0.20→$0.20 / 5.0 lite ¥0.22→$0.22 / 4.5 ¥0.25→$0.25）。
# 不设则用代码内置的同名默认值；DOUBAO_PRICE_USD 仅作「未知模型」的兜底价。
DOUBAO_PRICE_4_0=0.20
DOUBAO_PRICE_5_0_LITE=0.22
DOUBAO_PRICE_4_5=0.25
DOUBAO_PRICE_USD=0.10

# ─── 杂项 ────────────────────────────────────────────────
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_FORMAT=json
